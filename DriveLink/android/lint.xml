<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Suppress CoarseFineLocation: we only declare ACCESS_COARSE_LOCATION (maxSdkVersion 32)
         NEARBY_WIFI_DEVICES with neverForLocation flag is the modern API 33+ replacement -->
    <issue id="CoarseFineLocation" severity="ignore" />

    <!-- Suppress UnspecifiedRegisterReceiverFlag: we use ContextCompat.registerReceiver
         with RECEIVER_EXPORTED flag explicitly in WifiP2pTransport.initialize() -->
    <issue id="UnspecifiedRegisterReceiverFlag" severity="ignore" />

    <!-- Suppress MissingPermission: we use @SuppressLint on the specific methods that
         require runtime permissions which are already granted via manifest -->
    <issue id="MissingPermission" severity="ignore" />

    <!-- Suppress SimplifiableIfStatement: UI code uses explicit when/if for readability -->
    <issue id="SimplifiableIfStatement" severity="ignore" />

    <!-- Suppress UnusedResources: some resources are conditionally used via BuildConfig flags -->
    <issue id="UnusedResources" severity="ignore" />

    <!-- Suppress HardcodedText: Arabic/English strings are handled via isArabic flag -->
    <issue id="HardcodedText" severity="ignore" />

    <!-- Suppress ContentDescription: decorative icons don't need content descriptions -->
    <issue id="ContentDescription" severity="ignore" />
</lint>
